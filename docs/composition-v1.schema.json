{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Moments local composition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "revision", "createdAt", "updatedAt", "title", "location", "captionTitle", "caption", "sourceDates", "days", "time", "cities", "photos"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "title": { "type": "string", "minLength": 1, "maxLength": 140 },
    "location": { "type": "string", "minLength": 1, "maxLength": 300 },
    "captionTitle": { "type": "string", "maxLength": 140 },
    "caption": { "type": "string", "maxLength": 20000 },
    "sourceDates": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/date" } },
    "cities": { "$ref": "#/$defs/names" },
    "autoFill": {
      "type": "object", "additionalProperties": false, "required": ["time", "cities"],
      "properties": { "time": { "type": "boolean" }, "cities": { "type": "boolean" } },
      "default": { "time": true, "cities": true }
    },
    "days": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["captureDate", "date", "cities", "places"],
        "properties": {
          "captureDate": { "$ref": "#/$defs/date" },
          "date": { "$ref": "#/$defs/date" },
          "cities": { "$ref": "#/$defs/names" },
          "places": { "$ref": "#/$defs/names" }
        }
      }
    },
    "time": {
      "type": "object", "additionalProperties": false, "required": ["start", "end", "dates"],
      "properties": {
        "start": { "$ref": "#/$defs/date" }, "end": { "$ref": "#/$defs/date" },
        "dates": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/date" } }
      }
    },
    "photos": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "captureDate", "relativePath", "baseFile", "file", "filter"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-f0-9]{24}$" },
          "captureDate": { "$ref": "#/$defs/date" },
          "relativePath": { "type": "string", "minLength": 1 },
          "baseFile": { "type": "string", "pattern": "^base/(?:[a-f0-9]{24}-[a-f0-9]{20}|[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2,}_底图_v[0-9]{4,})\\.jpg$" },
          "file": { "type": "string", "pattern": "^images/(?:[a-f0-9]{24}-[a-f0-9]{20}|[0-9]{2,}_[0-9]{4}-[0-9]{2}-[0-9]{2}_v[0-9]{4,})\\.jpg$" },
          "filter": {
            "type": "object", "additionalProperties": false, "required": ["version", "preset", "strength"],
            "properties": {
              "version": { "const": 1 },
              "preset": { "enum": ["original", "clear", "warm-film", "cool-city", "soft-fade", "vivid", "mono", "sunset", "forest", "ocean", "cream", "peach", "retro", "cinema", "matte", "airy", "night", "soft-mono", "hard-mono", "neutral"] },
              "strength": { "type": "integer", "minimum": 0, "maximum": 100 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "date": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "names": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
  }
}
